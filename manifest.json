{
  "manifest_version": 3,
  "name": "ATS Resume Scorer",
  "version": "0.2.0",
  "description": "Score your resume against the current job description.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "ATS Resume Scorer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["pdf.worker.min.js", "pdf.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
